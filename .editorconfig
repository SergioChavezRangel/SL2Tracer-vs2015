# Top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# XML, JSON, and Project files
[*.{csproj,vbproj,sln,xml,json,config,props,targets}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# C# files
[*.cs]
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true

# Visual Basic files
[*.vb]
indent_size = 4
