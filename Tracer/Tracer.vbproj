<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Tracer</RootNamespace>
    <AssemblyName>Tracer</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>2.0.0</Version>
    <Authors>Sergio Chavez</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>A custom cross-platform logger with file rolling, purging, and hierarchical dictionary tracing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="My Project\Settings.Designer.vb" />
    <Compile Remove="My Project\Application.Designer.vb" />
  </ItemGroup>

  <ItemGroup>
    <None Update="PurgeConfig.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ToDo.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>