<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net8.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('windows'))">net8.0</TargetFramework>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('windows'))">WinExe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('windows'))">Library</OutputType>
    <UseWindowsForms Condition="$([MSBuild]::IsOSPlatform('windows'))">true</UseWindowsForms>
    <RootNamespace>TracerTest</RootNamespace>
    <AssemblyName>TracerTest</AssemblyName>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <ProjectReference Include="..\Tracer\Tracer.vbproj" />
  </ItemGroup>

  <!-- Non-Windows platforms skip WinForms compilation items cleanly -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('windows'))">
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <Target Name="SkipWinFormsNotice" BeforeTargets="BeforeBuild" Condition="!$([MSBuild]::IsOSPlatform('windows'))">
    <Message Importance="high" Text="Notice: TracerTest is a Windows Forms application and is only built on Windows. On macOS/Linux, run Tracer.Demo or Tracer.Tests." />
  </Target>

</Project>